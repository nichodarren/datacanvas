# Salin ke .env dan isi. JANGAN pernah commit .env (NFR-SEC.7).
# Variabel ditambahkan per fase — daftar ini tumbuh mengikuti roadmap §20.

# --- Fase 1: fondasi & identitas ---------------------------------------------
DATABASE_URL=postgresql://datacanvas:datacanvas@localhost:5432/datacanvas
# Dipakai test integrasi. Skemanya DIBANGUN ULANG DARI NOL setiap sesi pytest —
# jangan pernah arahkan ke database yang isinya kamu butuhkan.
TEST_DATABASE_URL=postgresql://datacanvas:datacanvas@localhost:5432/datacanvas_test
# Belum dipakai: sesi adalah token acak opaque yang disimpan ter-hash (§13.2),
# jadi tidak ada yang perlu ditandatangani. Disediakan untuk hal pertama yang
# memang butuh signing, supaya tidak ada nama variabel baru.
SESSION_SECRET=
LOG_LEVEL=INFO

# --- Fase 2: penyimpanan ------------------------------------------------------
# Lokal saat dev; S3-compatible di produksi. Jangan pakai layanan terkelola yang
# tidak punya padanan self-hosted (§19.2).
STORAGE_BACKEND=filesystem
STORAGE_ROOT=./storage

# --- Fase 5: copilot ----------------------------------------------------------
# Mode privasi default per workspace: strict | balanced | full | local (§13.5).
# `balanced` adalah keputusan OQ-4 dan sudah mencakup PG-1 (k-anonymity, k=5)
# serta PG-2 (maks 20 baris agregat).
DEFAULT_LLM_PRIVACY_MODE=balanced
LLM_PROVIDER=
LLM_API_KEY=
LLM_MONTHLY_TOKEN_BUDGET=
