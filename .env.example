# Salin ke .env dan isi. JANGAN pernah commit .env (NFR-SEC.7).
# Variabel ditambahkan per fase — daftar ini tumbuh mengikuti roadmap §20.

# --- Fase 1: fondasi & identitas ---------------------------------------------
DATABASE_URL=postgresql://datacanvas:datacanvas@localhost:5432/datacanvas
# Dipakai test integrasi. Skemanya DIBANGUN ULANG DARI NOL setiap sesi pytest —
# jangan pernah arahkan ke database yang isinya kamu butuhkan.
TEST_DATABASE_URL=postgresql://datacanvas:datacanvas@localhost:5432/datacanvas_test
# Belum dipakai: sesi adalah token acak opaque yang disimpan ter-hash (§13.2),
# jadi tidak ada yang perlu ditandatangani. Disediakan untuk hal pertama yang
# memang butuh signing, supaya tidak ada nama variabel baru.
SESSION_SECRET=
LOG_LEVEL=INFO

# --- Fase 2: penyimpanan ------------------------------------------------------
# Lokal saat dev; S3-compatible di produksi. Jangan pakai layanan terkelola yang
# tidak punya padanan self-hosted (§19.2).
STORAGE_BACKEND=filesystem
STORAGE_ROOT=./storage

# --- Fase 5: copilot ----------------------------------------------------------
# Mode privasi default per workspace: strict | balanced | full | local (§13.5).
# `balanced` adalah keputusan OQ-4 dan sudah mencakup PG-1 (k-anonymity, k=5)
# serta PG-2 (maks 20 baris agregat).
DEFAULT_LLM_PRIVACY_MODE=balanced
#
# MODEL BUKAN KONTRAK, KAPABILITAS YANG KONTRAK (D-076).
#
# v1 memaku `gemini-2.5-flash` di sini dan model itu shutdown 16 Oktober 2026.
# Migrasi wajib tiap 4-5 bulan adalah pola, jadi nama di bawah ini **diharapkan
# basi** dan diperlakukan begitu. Yang memutuskan sebuah model layak dipakai
# adalah `python -m app.llm` (probe kapabilitas) lalu golden queries (§12.9),
# bukan baris di file ini.
#
# Kunci milik provider, bukan milik posisi. Urutan tinggal di LLM_CASCADE saja.

# Dua kunci tambahan per provider, dari akun terpisah (D-096).
#
# Ini BUKAN fallback dalam arti yang cascade maksud: kunci kedua di balik
# vendor yang sama ikut mati saat vendornya mati, dan ikut pensiun saat
# modelnya pensiun. Yang TIDAK ia bagi adalah kuotanya -- dan plafon
# per-menit free tier itulah yang menghabisi turn enam langkah di tengah
# jalan.
#
# Kosongkan yang tidak dipakai. Kunci yang kosong dilewati, bukan ditolak,
# jadi mengisi satu berarti satu akun dan mengisi tiga berarti tiga.
# Lubang ditutup: mengisi slot 1 dan 3 memberi dua akun bernomor 1 dan 2.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.5-flash-lite

GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_MODEL=openrouter/free

# Mode `local` (§13.5).
OLLAMA_BASE_URL=http://localhost:11434
# Diukur di mesin ini: 8 GB VRAM + 15,7 GB RAM. `qwen3:30b-a3b` (18,6 GB) tidak
# muat di VRAM maupun RAM; `qwen3:8b` (5,2 GB) muat seluruhnya.
OLLAMA_MODEL=qwen3:8b

# Sendiri, karena model lokal memuat bobot ke VRAM pada panggilan pertama tiap
# periode idle: terukur 61 s (timeout), 27 s, lalu 4,3 s.
LLM_LOCAL_TIMEOUT_SECONDS=300

# Urutan cascade. Provider tanpa kunci dilewati, bukan bikin gagal start.
# Groq di depan karena **terukur**, bukan karena selera: satu turn bisa tujuh
# panggilan, dan `gemini-3.5-flash` 6.393 ms median berarti 45 detik per turn.
# Flash-Lite 916 ms, Groq 603 ms. Ketiganya lolos probe; jamnya yang beda.
LLM_CASCADE=groq,gemini,openrouter,ollama

LLM_TIMEOUT_SECONDS=60

# ⚠️ Free tier Gemini menyatakan prompt boleh dipakai melatih produk mereka.
# PG-1 dan PG-2 tetap bekerja, tapi §13.5 harus menyebutnya di UI.
LLM_MONTHLY_TOKEN_BUDGET=
